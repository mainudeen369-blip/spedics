# Neon Postgres (required for admin + dynamic API)
DATABASE_URL=

# Admin login (used if no admin_users row yet / fallback)
ADMIN_EMAIL=admin@spedics.local
ADMIN_PASSWORD=Admin@123

# JWT secret for admin session cookie
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Vercel Blob (photos + videos from Admin → Gallery)
# Vercel Dashboard → Storage → Blob → Create → copy read-write token
BLOB_READ_WRITE_TOKEN=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://spedics.vercel.app
